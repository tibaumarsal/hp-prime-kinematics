  PRINT(res);

  res := "ta(t) = " + STRING(ta(1)) + " i + " + STRING(ta(2)) + " y + " + STRING(ta(3)) + " z ";
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
