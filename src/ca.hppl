EXPORT ca()
BEGIN
  LOCAL x1, x2, y1, y2, z1, z2;
  LOCAL o1, o2, p1, p2;
  LOCAL ra1, ra2, ph1, ph2;
  LOCAL r, rm;
  LOCAL v, vm;
  LOCAL a, am;
  LOCAL ta, va, bi, no, at, an, cu, rc;
  LOCAL res;

// Derivar y operar usando CAS y guardar en variable local:

  CAS("x1:=simplify(diff(x))");
  CAS("x2:=simplify(diff(x1))");

  CAS("y1:=simplify(diff(y))");
  CAS("y2:=simplify(diff(y1))");

  CAS("z1:=simplify(diff(z))");
  CAS("z2:=simplify(diff(z1))");

  CAS("r := [ x(t), y(t), z(t) ]");
  r:=CAS("r");

  CAS("rm := sqrt(x(t)^2 + y(t)^2 + z(t)^2)");
  rm:=CAS("rm");

  CAS("v := [ x1(t), y1(t), z1(t) ]");
  v:=CAS("v");
  CAS("vm:= sqrt(x1(t)^2 + y1(t)^2 + z1(t)^2)");
  vm:=CAS("vm");

  CAS("a := [ x2(t), y2(t), z2(t) ]");
  a:=CAS("a");
  CAS("am:= sqrt(x2(t)^2 + y2(t)^2 + z2(t)^2)");
  am:=CAS("am");

  CAS("ta := v/vm ");
  ta:=CAS("ta");

  CAS("va := cross(v,a)");
  CAS("bi := cross(v,a)/sqrt(va(1)^2+va(2)^2+va(3)^2))");
  bi:=CAS("bi");

  CAS("no := cross(bi,ta)");
  no:=CAS("no");

  CAS("at := a*ta");
  at:=CAS("at");

  CAS("an := a*no");
  an:=CAS("an");

  CAS("cu := sqrt(va(1)^2+va(2)^2+va(3)^2)/vm^3");
  cu:=CAS("cu");

  CAS("rc := 1/cu");
  rc:=CAS("rc");   


// Mostrar en pantalla
  PRINT();

  res := "r(t) = " + STRING(r(1)) + " i + " + STRING(r(2)) + " y + " + STRING(r(3)) + " z " ;
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
  res := REPLACE(res, "diff(y(t),t)", "y(t)'");
  res := REPLACE(res, "diff(z(t),t,2)", "z(t)''");
  res := REPLACE(res, "diff(z(t),t)", "z(t)'");
  res := REPLACE(res, "diff(p(t),t,2)", "p(t)''");
  res := REPLACE(res, "diff(p(t),t)", "p(t)'");
  res := REPLACE(res, "diff(o(t),t,2)", "o(t)''");
  res := REPLACE(res, "diff(o(t),t)", "o(t)'");  
  res := REPLACE(res, "diff(ra(t),t,2)", "ra(t)''");
  res := REPLACE(res, "diff(ra(t),t)", "ra(t)'");
  res := REPLACE(res, "diff(ph(t),t,2)", "ph(t)''");
  res := REPLACE(res, "diff(ph(t),t)", "ph(t)'");  
  PRINT(res);

  res := "v(t) = " + STRING(v(1)) + " i + " + STRING(v(2)) + " y + " + STRING(v(3)) + " z ";
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
