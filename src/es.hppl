  res := REPLACE(res, "diff(p(t),t,2)", "p(t)''");
  res := REPLACE(res, "diff(p(t),t)", "p(t)'");
  res := REPLACE(res, "diff(o(t),t,2)", "o(t)''");
  res := REPLACE(res, "diff(o(t),t)", "o(t)'");  
  res := REPLACE(res, "diff(ra(t),t,2)", "ra(t)''");
  res := REPLACE(res, "diff(ra(t),t)", "ra(t)'");
  res := REPLACE(res, "diff(ph(t),t,2)", "ph(t)''");
  res := REPLACE(res, "diff(ph(t),t)", "ph(t)'");  
  PRINT(res);

  res := "||r(t)|| = " + STRING(rm);
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
  res := REPLACE(res, "diff(y(t),t)", "y(t)'");
  res := REPLACE(res, "diff(z(t),t,2)", "z(t)''");
  res := REPLACE(res, "diff(z(t),t)", "z(t)'");
  res := REPLACE(res, "diff(p(t),t,2)", "p(t)''");
  res := REPLACE(res, "diff(p(t),t)", "p(t)'");
  res := REPLACE(res, "diff(o(t),t,2)", "o(t)''");
  res := REPLACE(res, "diff(o(t),t)", "o(t)'");  
  res := REPLACE(res, "diff(ra(t),t,2)", "ra(t)''");
  res := REPLACE(res, "diff(ra(t),t)", "ra(t)'");
  res := REPLACE(res, "diff(ph(t),t,2)", "ph(t)''");
  res := REPLACE(res, "diff(ph(t),t)", "ph(t)'");   
  PRINT(res);

  res := "||v(t)|| = " + STRING(vm);
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
