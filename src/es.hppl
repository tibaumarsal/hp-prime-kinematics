EXPORT es()
BEGIN
  LOCAL x1, x2, y1, y2, z1, z2;
  LOCAL o1, o2, p1, p2;
  LOCAL ra1, ra2, ph1, ph2;
  LOCAL r, rm;
  LOCAL v, vm;
  LOCAL a, am;
  LOCAL ta, va, bi, no, at, an, cu, rc;
  LOCAL res;

// Derivar y operar usando CAS y guardar en variable local:
  
  CAS("ra1:=(diff(ra))");
  CAS("ra2:=(diff(ra1))");

  CAS("o1:=(diff(o))");
  CAS("o2:=(diff(o1))");

  CAS("ph1:=(diff(ph))");
  CAS("ph2:=(diff(ph1))");

  CAS("r := [ ra(t)]");
  r:=CAS("r");

  CAS("rm := (sqrt(ra(t)^2 + o(t)^2 + ph(t)^2))");
  rm:=CAS("rm");

  CAS("v := [ ra1(t), ra(t)*o1(t), ra(t)*ph1(t)*sin(o(t)) ]");
  v:=CAS("v");
  CAS("vm:= (sqrt(ra1(t)^2 + (ra(t)*o1(t))^2 + (ra(t)*ph1(t)*sin(o(t)))^2))");
  vm:=CAS("vm");

  CAS("a := [ ra2(t)-ra(t)*o1(t)^2-ra(t)*ph(t)^2*sin(o(t))^2, ra(t)*o2(t)-ra(t)+ph1(t)^2*sin(o(t))+cos(o(t))+2*ra1(t)*o1(t), ra(t)*ph2(t)*sin(o(t))+2*ra1(t)*ph1(t)*sin(o(t))+2*ra(t)*o1(t)*cos(o(t)) ]");
  a:=CAS("a");
  CAS("am:= (ra2(t)-ra(t)*o1(t)^2-ra(t)*ph(t)^2*sin(o(t))^2)^2 + (ra(t)*o2(t)-ra(t)+ph1(t)^2*sin(o(t))+cos(o(t))+2*ra1(t)*o1(t))^2 + (ra(t)*ph2(t)*sin(o(t))+2*ra1(t)*ph1(t)*sin(o(t))+2*ra(t)*o1(t)*cos(o(t)))^2)");
  am:=CAS("am");

  CAS("ta := v/vm ");
  ta:=CAS("ta");

  CAS("va := cross(v,a)");
  CAS("bi := cross(v,a)/sqrt(va(1)^2+va(2)^2+va(3)^2))");
  bi:=CAS("bi");

  CAS("no := cross(bi,ta)");
  no:=CAS("no");

  CAS("at := a*ta");
  at:=CAS("at");

  CAS("an := a*no");
  an:=CAS("an");

  CAS("cu := sqrt(va(1)^2+va(2)^2+va(3)^2)/vm^3");
  cu:=CAS("cu");

  CAS("rc := 1/cu");
  rc:=CAS("rc");   


// Mostrar en pantalla
  PRINT();

  res := "r(t) = " + STRING(r(1)) ;
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
  res := REPLACE(res, "diff(y(t),t)", "y(t)'");
  res := REPLACE(res, "diff(z(t),t,2)", "z(t)''");
  res := REPLACE(res, "diff(z(t),t)", "z(t)'");
  res := REPLACE(res, "diff(p(t),t,2)", "p(t)''");
  res := REPLACE(res, "diff(p(t),t)", "p(t)'");
  res := REPLACE(res, "diff(o(t),t,2)", "o(t)''");
  res := REPLACE(res, "diff(o(t),t)", "o(t)'");  
  res := REPLACE(res, "diff(ra(t),t,2)", "ra(t)''");
  res := REPLACE(res, "diff(ra(t),t)", "ra(t)'");
  res := REPLACE(res, "diff(ph(t),t,2)", "ph(t)''");
  res := REPLACE(res, "diff(ph(t),t)", "ph(t)'");  
  PRINT(res);

  res := "v(t) = " + STRING(v(1)) + " ep + " + STRING(v(2)) + " eo + " + STRING(v(3)) + " es ";
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
  res := REPLACE(res, "diff(y(t),t)", "y(t)'");
  res := REPLACE(res, "diff(z(t),t,2)", "z(t)''");
  res := REPLACE(res, "diff(z(t),t)", "z(t)'");
  res := REPLACE(res, "diff(p(t),t,2)", "p(t)''");
  res := REPLACE(res, "diff(p(t),t)", "p(t)'");
  res := REPLACE(res, "diff(o(t),t,2)", "o(t)''");
  res := REPLACE(res, "diff(o(t),t)", "o(t)'");  
  res := REPLACE(res, "diff(ra(t),t,2)", "ra(t)''");
  res := REPLACE(res, "diff(ra(t),t)", "ra(t)'");
  res := REPLACE(res, "diff(ph(t),t,2)", "ph(t)''");
  res := REPLACE(res, "diff(ph(t),t)", "ph(t)'");  
  PRINT(res);

  res := "a(t) = " + STRING(a(1)) + " ep + " + STRING(a(2)) + " eo + " + STRING(a(3)) + " es ";
  res := REPLACE(res, "diff(x(t),t,2)", "x(t)''");
  res := REPLACE(res, "diff(x(t),t)", "x(t)'");
  res := REPLACE(res, "diff(y(t),t,2)", "y(t)''");
  res := REPLACE(res, "diff(y(t),t)", "y(t)'");
  res := REPLACE(res, "diff(z(t),t,2)", "z(t)''");
